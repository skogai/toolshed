{
  "permissions": {
    "allow": [
      "Bash(node plugins/sidequest/bin/sidequest.js:*)",
      "Bash(node plugins/codex-gateway/bin/codex-gateway.js:*)",
      "Bash(node --test:*)",
      "Bash(git:*)"
    ]
  },
  "enabledPlugins": {
    "sidequest@eigenwise-toolshed": true,
    "svelte@svelte": true,
    "codebase-mapper@eigenwise-toolshed": true,
    "observability@eigenwise-toolshed": true,
    "quartermaster@eigenwise-toolshed": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-doc-drift.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
